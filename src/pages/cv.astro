---
// The CV as a web page. Edit the text in src/content/cv.json.
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../content/site.json';
import cv from '../content/cv.json';
---

<BaseLayout
  title={`CV, ${site.name}`}
  description="Education, experience, leadership and skills of Farrel Jonathan Vickeldo, AI engineer and MSc student in Smart Medicine and Health Informatics at National Taiwan University."
>
  <article class="cv page">
    <header class="cv__head">
      <h1>Curriculum vitae</h1>
      <p class="cv__summary">{cv.summary}</p>
      <p class="cv__actions">
        <a class="button button--primary" href={site.cv} download>Download CV (PDF)</a>
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </p>
    </header>

    <section aria-labelledby="exp">
      <h2 id="exp">Experience</h2>
      <ol class="timeline">
        {cv.experience.map((job) => (
          <li class="entry">
            <p class="entry__dates">{job.dates}</p>
            <div>
              <h3>{job.role}, <span class="entry__org">{job.org}</span></h3>
              {job.about && <p class="entry__about">{job.about}</p>}
              <ul>{job.points.map((pt) => <li>{pt}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="edu">
      <h2 id="edu">Education</h2>
      <ol class="timeline">
        {cv.education.map((ed) => (
          <li class="entry">
            <p class="entry__dates">{ed.dates}</p>
            <div>
              <h3>{ed.degree}, <span class="entry__org">{ed.school}</span></h3>
              <p class="entry__about">{ed.place}</p>
              <ul>{ed.points.map((pt) => <li>{pt}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
      <p class="cv__more"><a href="/work/tiny-detector/">Read the Tiny Detector case</a></p>
    </section>

    <section aria-labelledby="lead">
      <h2 id="lead">Leadership</h2>
      <ol class="timeline">
        {cv.leadership.map((item) => (
          <li class="entry">
            <p class="entry__dates">{item.dates}</p>
            <div>
              <h3>{item.role}, <span class="entry__org">{item.org}</span></h3>
              <ul>{item.points.map((pt) => <li>{pt}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="other">
      <h2 id="other">Other projects</h2>
      <p class="section-intro">Projects with full case studies are on the <a href="/work/">projects page</a>. These are listed on my CV but not yet written up.</p>
      <ul class="plain">
        {cv.otherProjects.map((pr) => (
          <li><strong>{pr.name}</strong> ({pr.year}). {pr.text}</li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="skills">
      <h2 id="skills">Skills</h2>
      <dl class="skills">
        {cv.skills.map((s) => (
          <div><dt>{s.group}</dt><dd>{s.items}</dd></div>
        ))}
      </dl>
    </section>

    <div class="cv__grid">
      <section aria-labelledby="certs">
        <h2 id="certs">Certifications</h2>
        <ul class="plain">{cv.certifications.map((c) => <li>{c}</li>)}</ul>
      </section>
      <section aria-labelledby="awards">
        <h2 id="awards">Awards</h2>
        <ul class="plain">{cv.awards.map((a) => <li>{a}</li>)}</ul>
      </section>
      <section aria-labelledby="langs">
        <h2 id="langs">Languages</h2>
        <ul class="plain">{cv.languages.map((l) => <li>{l}</li>)}</ul>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .cv { padding-block: 3rem 4rem; }
  .cv h1 { font-size: var(--step-4); }
  .cv h2 { font-size: var(--step-2); margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--rule); }
  .cv h3 { font-size: var(--step-1); margin-bottom: 0.25rem; }
  .cv__summary { font-size: var(--step-1); line-height: 1.5; }
  .cv__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; }
  .entry__org { font-weight: 450; }

  .timeline { list-style: none; padding: 0; margin: 0; }
  .entry { display: grid; gap: 0.25rem 2rem; padding-block: 1.25rem; }
  .entry + .entry { border-top: 1px solid var(--rule); }
  .entry__dates { font-size: var(--step--1); color: var(--muted); font-weight: 600; margin: 0; }
  .entry__about { color: var(--muted); margin-bottom: 0.5rem; }
  .entry ul { padding-left: 1.25rem; max-width: var(--measure); }
  .entry li + li { margin-top: 0.3rem; }
  @media (min-width: 760px) {
    .entry { grid-template-columns: 11rem 1fr; }
    .entry__dates { padding-top: 0.3rem; }
  }

  .plain { padding-left: 1.25rem; max-width: var(--measure); }
  .plain li + li { margin-top: 0.4rem; }
  .cv__more { font-weight: 600; }

  .skills { display: grid; gap: 1rem; max-width: var(--measure); }
  .skills dt { font-weight: 700; }
  .skills dd { margin: 0; }

  .cv__grid { display: grid; gap: 0 2rem; }
  @media (min-width: 900px) { .cv__grid { grid-template-columns: repeat(3, 1fr); } }
</style>
