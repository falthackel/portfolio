---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import site from '../../content/site.json';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={`All projects, ${site.name}`}
  description="Applied AI projects in agentic LLM tools, computer vision on factory lines and retrieval-augmented Q&A, each written up through an engineering and a product lens."
>
  <section class="section page" aria-labelledby="all-heading">
    <h1 id="all-heading">All projects</h1>
    <p class="section-intro">Newest and most relevant first. Use the lens switch in the header to focus on engineering or product detail.</p>
    <div class="grid">
      {projects.map((project) => <ProjectCard project={project} headingLevel="h2" />)}
    </div>
  </section>
</BaseLayout>

<style>
  h1 { font-size: var(--step-4); }
  .grid { display: grid; gap: 1.5rem; margin-top: 2rem; }
  @media (min-width: 900px) { .grid { grid-template-columns: 1fr 1fr; gap: 2rem; } }
</style>
