---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectSection from '../../components/ProjectSection.astro';
import site from '../../content/site.json';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const inSection = (category: string) => all.filter((p) => p.data.category === category);
---

<BaseLayout
  title={`All projects, ${site.name}`}
  description="Industry AI projects, self-projects on health data and LLM agents, and an autism screening app from university, each written up through an engineering and a product lens."
>
  <div class="page intro">
    <h1>All projects</h1>
    <p class="section-intro">Use the lens switch in the header to focus on engineering or product detail.</p>
  </div>
  <ProjectSection id="work" title={site.sections.work.title} intro={site.sections.work.intro} projects={inSection('work')} />
  <ProjectSection id="self-projects" title={site.sections.self.title} intro={site.sections.self.intro} projects={inSection('self')} />
  <ProjectSection id="school" title={site.sections.school.title} intro={site.sections.school.intro} projects={inSection('school')} />
</BaseLayout>

<style>
  .intro { padding-top: 3rem; }
  h1 { font-size: var(--step-4); }
</style>
