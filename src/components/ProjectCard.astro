---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { project, featured = false, headingLevel = 'h3' } = Astro.props;
const p = project.data;
const Heading = headingLevel;
const href = `/work/${project.id}/`;
---

<article class:list={['card', { 'card--featured': featured }]} data-lenses={p.lenses.join(' ')}>
  <div class="card__media">
    <Image
      src={p.thumbnail}
      alt={p.thumbnailAlt}
      widths={featured ? [480, 800, 1200, 1600] : [480, 800, 1200]}
      sizes={featured ? '(min-width: 64em) 45vw, 100vw' : '(min-width: 80em) 50vw, 100vw'}
      loading="lazy"
    />
  </div>
  <div class="card__body">
    <p class="label">{p.type}, {p.date}</p>
    <Heading class="card__title"><a href={href}>{p.title}</a></Heading>
    <p class="card__summary">{p.summary}</p>
    <div class="card__lenses">
      {p.engineerLine && p.lenses.includes('engineer') && (
        <p data-for="engineer"><span class="lens-chip lens-chip--engineer">Engineer</span> {p.engineerLine}</p>
      )}
      {p.productLine && p.lenses.includes('product') && (
        <p data-for="product"><span class="lens-chip lens-chip--product">Product</span> {p.productLine}</p>
      )}
    </div>
    <a class="card__more" href={href}>Read the case<span class="visually-hidden">: {p.title}</span></a>
  </div>
</article>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  /* Every picture sits on the same colored mat, inside a fixed 16:10 frame.
     The picture keeps its own shape and is centered, so wide, tall and square
     images all look deliberately placed instead of letterboxed. */
  .card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--mat);
    border-bottom: 1px solid var(--rule);
  }
  .card__media img {
    position: absolute;
    inset: 0;
    margin: auto;
    width: auto;
    height: auto;
    max-width: calc(100% - 2.5rem);
    max-height: calc(100% - 2.5rem);
    background: #fff; /* backing for any picture with see-through parts */
    border: 1px solid var(--rule);
    border-radius: 4px;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
  }
  .card__body { padding: 1.25rem 1.25rem 1.5rem; display: flex; flex-direction: column; flex: 1; }
  .card__title { font-size: var(--step-1); }
  .card__title a { color: var(--ink); text-decoration: none; }
  .card__title a:hover { text-decoration: underline; text-underline-offset: 0.18em; }
  .card__summary { margin-bottom: 1rem; }
  .card__lenses p { font-size: var(--step--1); color: var(--muted); margin-bottom: 0.6rem; }
  .card__lenses .lens-chip { margin-right: 0.35rem; }
  .card__more { margin-top: auto; padding-top: 0.5rem; font-weight: 600; align-self: flex-start; }

  .card--featured .card__title { font-size: var(--step-3); }
  .card--featured .card__summary { font-size: var(--step-1); line-height: 1.45; }

  @media (min-width: 900px) {
    .card--featured { flex-direction: row; }
    .card--featured .card__media {
      flex: 0 0 55%;
      aspect-ratio: auto;
      min-height: 22rem;
      border-bottom: 0;
      border-right: 1px solid var(--rule);
    }
    .card--featured .card__media img {
      max-width: calc(100% - 3rem);
      max-height: calc(100% - 3rem);
    }
    .card--featured .card__body { padding: 2rem; }
  }
</style>
