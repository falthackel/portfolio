---
// The ECG-style signature line in the hero. Draws itself once on page load;
// with reduced motion turned on it simply appears.
---

<svg class="waveform" viewBox="0 0 600 60" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <path
    pathLength="1"
    d="M0,34 L150,34 L162,30 L172,34 L190,34 L198,40 L210,6 L222,52 L232,34 L262,34 L278,26 L296,34 L600,34"
  />
</svg>

<style>
  .waveform {
    width: 100%;
    height: 60px;
    margin-top: 2.5rem;
  }
  .waveform path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: draw 1.8s ease-out both;
  }
  @keyframes draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .waveform path { animation: none; }
  }
</style>
