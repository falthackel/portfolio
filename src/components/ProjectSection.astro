---
// One group of project cards (Work, Self-projects or School).
// Projects with featured: true get a full-width card.
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

interface Props {
  id: string;
  title: string;
  intro: string;
  projects: CollectionEntry<'projects'>[];
  headingLevel?: 'h1' | 'h2';
}
const { id, title, intro, projects, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const cardHeading = headingLevel === 'h1' ? 'h2' : 'h3';
---

<section id={id} class="section page project-section" aria-labelledby={`${id}-heading`}>
  <Heading id={`${id}-heading`}>{title}</Heading>
  <p class="section-intro">{intro}</p>
  <div class="project-grid">
    {projects.map((project) =>
      project.data.featured ? (
        <div class="project-grid__wide"><ProjectCard project={project} featured headingLevel={cardHeading} /></div>
      ) : (
        <ProjectCard project={project} headingLevel={cardHeading} />
      ),
    )}
  </div>
  <slot />
</section>

<style>
  /* Cards keep a readable minimum width in rem, so it follows the text size.
     Each row fits as many cards as there is room for: zooming out adds columns,
     zooming in or a phone drops to one. The featured card always spans the row. */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(25rem, 100%), 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }
  .project-grid__wide { grid-column: 1 / -1; }
</style>
