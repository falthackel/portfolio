---
import '../styles/global.css';
import Header from '../components/Header.astro';
import site from '../content/site.json';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#F7F8FB" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#10163A" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Runs before the page paints: sets theme and lens so there is no flash. -->
    <script is:inline>
      (function () {
        var d = document.documentElement, t, l;
        d.classList.add('js');
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.dataset.theme = t;
        var ok = /^(both|engineer|product)$/;
        l = new URLSearchParams(location.search).get('lens');
        if (ok.test(l || '')) { try { localStorage.setItem('lens', l); } catch (e) {} }
        else { try { l = localStorage.getItem('lens'); } catch (e) {} }
        d.dataset.lens = ok.test(l || '') ? l : 'both';
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,400..700;1,400&family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="page site-footer__inner">
        <p>{site.name}, {site.contact.location}</p>
        <p class="site-footer__links">
          <a href={`mailto:${site.contact.email}`}>Email</a>
          <a href={site.contact.linkedin} rel="noopener">LinkedIn</a>
          <a href={site.contact.github} rel="noopener">GitHub</a>
        </p>
      </div>
    </footer>
    <p class="visually-hidden" aria-live="polite" data-lens-status></p>

    <script>
      // Theme toggle and lens switch. Everything else on the site is static HTML.
      const root = document.documentElement;
      const LENS_NAMES: Record<string, string> = { both: 'both lenses', engineer: 'the Engineer lens', product: 'the Product lens' };
      const status = document.querySelector('[data-lens-status]');

      function showLens(lens: string) {
        root.dataset.lens = lens;
        document.querySelectorAll<HTMLElement>('[data-set-lens]').forEach((b) =>
          b.setAttribute('aria-pressed', String(b.dataset.setLens === lens)),
        );
      }

      function chooseLens(lens: string) {
        showLens(lens);
        try { localStorage.setItem('lens', lens); } catch {}
        const url = new URL(location.href);
        if (lens === 'both') url.searchParams.delete('lens');
        else url.searchParams.set('lens', lens);
        history.replaceState(history.state, '', url);
        if (status) status.textContent = `Showing ${LENS_NAMES[lens]}.`;
      }

      document.addEventListener('click', (event) => {
        const button = (event.target as Element).closest<HTMLElement>('[data-set-lens]');
        if (button?.dataset.setLens) chooseLens(button.dataset.setLens);
      });
      showLens(root.dataset.lens || 'both');

      // Theme
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const applyTheme = (theme: string) => {
        root.dataset.theme = theme;
        toggle?.setAttribute('aria-pressed', String(theme === 'dark'));
      };
      applyTheme(root.dataset.theme || 'light');
      toggle?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        applyTheme(next);
        try { localStorage.setItem('theme', next); } catch {}
      });
      // Follow the system setting live, unless the visitor has picked a theme.
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        let saved: string | null = null;
        try { saved = localStorage.getItem('theme'); } catch {}
        if (!saved) applyTheme(e.matches ? 'dark' : 'light');
      });
    </script>

    <style is:global>
      html:not(.js) .js-only { display: none !important; }
      .site-footer { border-top: 1px solid var(--rule); padding-block: 2rem; color: var(--muted); font-size: var(--step--1); }
      .site-footer__inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; }
      .site-footer p { margin: 0; }
      .site-footer__links { display: flex; gap: 1.25rem; }
    </style>
  </body>
</html>
